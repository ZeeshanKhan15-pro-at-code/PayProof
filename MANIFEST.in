include README.md Makefile requirements-dev.txt
recursive-include docs *.md
recursive-include benchmarks *.json *.txt *.md *.html
recursive-include tests *.py
recursive-include scripts *.py
recursive-include payproof/fixtures *.json
recursive-include payproof/migrations *.sql
recursive-include payproof/templates *.html
recursive-include payproof/static *.css *.js

global-exclude .env .env.* *.pem *.key
