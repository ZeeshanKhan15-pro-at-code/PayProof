# Process environment is authoritative. scripts/run_local.py loads private .env defaults.
# Optional local use: cp .env.example .env; edit .env, then source it as described in README.
PAYPROOF_ENV=development
PAYPROOF_PORT=8000
PAYPROOF_DATA_DIR=./data
PAYPROOF_EXTRACTION_MODE=disabled
# Optional live extraction: mode=live plus key and a structured-output model.
# Source text is sent only by an explicit live extraction call.
PAYPROOF_PROVIDER=featherless
PAYPROOF_PROVIDER_BASE_URL=https://api.featherless.ai/v1
PAYPROOF_PROVIDER_API_KEY=
# Featherless uses chat completions; openai uses Responses.
# Set an explicitly compatible model; a nonblank name alone is not readiness proof.
PAYPROOF_PROVIDER_MODEL=Qwen/Qwen3.8-27B
PAYPROOF_EXTRACTION_TIMEOUT_SECONDS=30
# Set an independently generated value of at least 32 characters for production.
# No default signing secret is supplied. Keep real values in .env or host secrets.
PAYPROOF_SECRET_KEY=

# Writable operator pages require a distinct random passphrase (32+ characters)
# and PAYPROOF_SECRET_KEY (32+ characters). Configure only via environment.
PAYPROOF_OPERATOR_TOKEN=

# Anonymous live extraction is opt-in; persistent global lifetime call cap.
PAYPROOF_PUBLIC_LIVE_ENABLED=false
PAYPROOF_PUBLIC_LIVE_MAX_CALLS=20
