# Process environment is authoritative. No automatic .env loading.
# Optional local use: cp .env.example .env; edit .env, then source it as described in README.
PAYPROOF_ENV=development
PAYPROOF_PORT=8000
PAYPROOF_DATA_DIR=./data
PAYPROOF_EXTRACTION_MODE=disabled
# Optional live extraction: mode=live plus key and a structured-output model.
# Plain source text is sent to OpenAI only by an explicit extraction call.
PAYPROOF_PROVIDER_API_KEY=
PAYPROOF_PROVIDER_MODEL=Qwen/Qwen3.8-27B
PAYPROOF_EXTRACTION_TIMEOUT_SECONDS=30
# Set an independently generated value of at least 32 characters for production.
# No default signing secret is supplied. Keep real values in .env or host secrets.
PAYPROOF_SECRET_KEY=
